# 저장소에는 clone 후 컨테이너를 바로 띄우는 데 필요한 것만 둔다.
# 문서, 벤치마크, 원본 데이터, 런타임에서 읽지 않는 인덱스는 제외한다.

# 로컬 환경
.env
.env.*
**/.venv/
**/node_modules/
**/__pycache__/
*.log
*.tmp
*.before-*

# 문서. 실행 안내용 README만 저장소에 둔다.
*.md
!README.md

# 벤치마크·조사 스크립트와 예제
gloss-recommender/bench/
gloss-recommender/examples/
transfer-rsync.excludes

# 원본 데이터와 중간 산출물
dataset-builder/data/raw/

# dataset-builder/data 최상위 인덱스는 server.js가 참조하지 않는다.
# 80MB짜리 embedding_rag_index.json도 여기서 걸러진다.
dataset-builder/data/*.json

# llm_pipeline 은 서버가 기동 시 읽는 5개만 남긴다.
dataset-builder/data/llm_pipeline/*
!dataset-builder/data/llm_pipeline/question_answer_pool.json
!dataset-builder/data/llm_pipeline/question_retrieval_index.json
!dataset-builder/data/llm_pipeline/test_658_gloss_vector_db.json
!dataset-builder/data/llm_pipeline/keyword_gloss_map.json
!dataset-builder/data/llm_pipeline/intent_gloss_sets.json
